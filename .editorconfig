root = true

[*]
end_of_line = lf
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
# Formatting is palantir-java-format through Spotless (mvn spotless:apply); these keep IntelliJ in line with it.
max_line_length = 120
ij_any_class_brace_style = end_of_line
ij_any_block_brace_style = end_of_line
ij_any_if_brace_force = always
ij_any_for_brace_force = always
ij_any_while_brace_force = always
ij_any_do_while_brace_force = always
ij_java_class_count_to_use_import_on_demand = 9999
ij_java_names_count_to_use_import_on_demand = 9999

[*.{yml,yaml,json}]
indent_size = 2
